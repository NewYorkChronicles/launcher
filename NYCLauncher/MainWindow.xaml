<Window x:Class="NYCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New York Chronicles"
        Icon="Assets/icon.ico"
        Width="720" Height="332"
        MinWidth="720" MinHeight="332"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0A0A0C"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <FontFamily x:Key="SansFont">pack://application:,,,/Assets/Fonts/#Geist</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#Geist Mono</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Druk Wide Bold</FontFamily>

    <SolidColorBrush x:Key="BgPanel" Color="#0A0A0C"/>
    <SolidColorBrush x:Key="BgSurface" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="BorderSoft" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F7F7F9"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A8E4E4E8"/>
    <SolidColorBrush x:Key="TextDim" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="TextSubtle" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="TextFaint" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="Red" Color="#E81E13"/>
    <SolidColorBrush x:Key="RedHover" Color="#FF4338"/>
    <SolidColorBrush x:Key="RedActive" Color="#AA1209"/>
    <SolidColorBrush x:Key="Green" Color="#3BCC6A"/>
    <SolidColorBrush x:Key="Track" Color="#0FFFFFFF"/>

    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="Caption">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="StatValue">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="LaunchBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="6" Background="{StaticResource Red}"
                      Opacity="0" Margin="-2">
                <Border.Effect>
                  <BlurEffect Radius="18" KernelType="Gaussian"/>
                </Border.Effect>
              </Border>

              <Border x:Name="Surface" CornerRadius="6" ClipToBounds="True"
                      RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GradTop"    Color="#FF2A1F" Offset="0"/>
                    <GradientStop x:Name="GradBottom" Color="#C41A10" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Grid>
                  <Rectangle x:Name="Skyline" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Width="360" Height="56" Fill="Black" Opacity="0.75">
                    <Rectangle.OpacityMask>
                      <ImageBrush ImageSource="/Assets/skyline.png"
                                  Stretch="Uniform" AlignmentX="Left" AlignmentY="Bottom"/>
                    </Rectangle.OpacityMask>
                  </Rectangle>

                  <Rectangle x:Name="Sheen" Width="120" HorizontalAlignment="Left"
                             IsHitTestVisible="False" Opacity="0">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#3FFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                      <TranslateTransform X="-160"/>
                    </Rectangle.RenderTransform>
                  </Rectangle>

                  <Rectangle Height="1" VerticalAlignment="Top" Fill="#22FFFFFF"/>

                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                    TextElement.Foreground="White"
                                    Margin="{TemplateBinding Padding}"/>
                </Grid>
              </Border>
            </Grid>

            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="UIElement.MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sheen"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Sheen"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-160" To="640" Duration="0:0:0.7"
                                     AccelerationRatio="0.2" DecelerationRatio="0.4"/>
                    <ColorAnimation Storyboard.TargetName="GradTop"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF5247" Duration="0:0:0.22"/>
                    <ColorAnimation Storyboard.TargetName="GradBottom"
                                    Storyboard.TargetProperty="Color"
                                    To="#E81E13" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="Glow"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.55" Duration="0:0:0.28"/>
                    <DoubleAnimation Storyboard.TargetName="Surface"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1.03" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="Surface"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1.008" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>

              <EventTrigger RoutedEvent="UIElement.MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sheen"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.2"/>
                    <ColorAnimation Storyboard.TargetName="GradTop"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF2A1F" Duration="0:0:0.22"/>
                    <ColorAnimation Storyboard.TargetName="GradBottom"
                                    Storyboard.TargetProperty="Color"
                                    To="#C41A10" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="Glow"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.28"/>
                    <DoubleAnimation Storyboard.TargetName="Surface"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="Surface"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="0:0:0.22"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>

              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.92"/>
              </Trigger>

              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Background" Value="#1E1E24"/>
                <Setter TargetName="Skyline" Property="Opacity" Value="0.25"/>
                <Setter TargetName="Glow" Property="Opacity" Value="0"/>
                <Setter Property="Foreground" Value="#80FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FooterLink" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource RedHover}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0D0D11" Offset="0"/>
          <GradientStop Color="#0A0A0C" Offset="0.55"/>
          <GradientStop Color="#0A0A0C" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush GradientOrigin="0.92,0.08" Center="0.92,0.08" RadiusX="0.7" RadiusY="0.9">
          <GradientStop Color="#33E81E13" Offset="0"/>
          <GradientStop Color="#00E81E13" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush GradientOrigin="0.08,1.0" Center="0.08,1.0" RadiusX="0.7" RadiusY="0.9">
          <GradientStop Color="#22FF4338" Offset="0"/>
          <GradientStop Color="#00FF4338" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Rectangle Height="1" VerticalAlignment="Top" Fill="#14FFFFFF" IsHitTestVisible="False"/>

    <Grid x:Name="Content" Grid.RowSpan="2" Opacity="0" d:Opacity="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="26,22,26,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <Image Source="Assets/logo_wide.png" Height="76" HorizontalAlignment="Center"
                 Margin="0,0,0,20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

          <Border Background="{StaticResource BgSurface}"
                  BorderBrush="{StaticResource BorderSoft}"
                  BorderThickness="1" CornerRadius="10" Padding="18,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Caption}" Text="STATUS" Margin="0,0,0,7"/>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Green}" Margin="0,0,10,0">
                    <Ellipse.Effect>
                      <DropShadowEffect Color="#3BCC6A" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                    </Ellipse.Effect>
                  </Ellipse>
                  <TextBlock x:Name="StatusText" Style="{StaticResource StatValue}"
                             Text="Online" Foreground="{StaticResource Green}" FontWeight="SemiBold"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Caption}" Text="PLAYERS" Margin="0,0,0,7"/>
                <TextBlock Style="{StaticResource StatValue}">
                  <Run x:Name="PlayersRun" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/><Run Text=" / "/><Run x:Name="MaxPlayersRun" Text="—" Foreground="{StaticResource TextSubtle}"/>
                </TextBlock>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">

          <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,9">
              <TextBlock x:Name="StatusLabel" Text="Ready to play"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         FontWeight="Medium"
                         Foreground="{StaticResource TextDim}"
                         HorizontalAlignment="Left"/>
              <TextBlock x:Name="ProgressPct" Text="—"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                         HorizontalAlignment="Right"/>
            </Grid>

            <Border Grid.Row="1" Height="5" Background="{StaticResource Track}" CornerRadius="2.5" ClipToBounds="True">
              <Grid HorizontalAlignment="Left" Width="0" x:Name="ProgressFillContainer">
                <Rectangle RadiusX="2.5" RadiusY="2.5">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#FF4338" Offset="0"/>
                      <GradientStop Color="#E81E13" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
              </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0">
              <StackPanel Margin="0,0,32,0">
                <TextBlock Style="{StaticResource Caption}" FontSize="9.5" Text="SPEED" Margin="0,0,0,3"/>
                <TextBlock x:Name="SpeedText" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource TextPrimary}" Text="—" TextTrimming="None"/>
              </StackPanel>
              <StackPanel Margin="32,0,0,0">
                <TextBlock Style="{StaticResource Caption}" FontSize="9.5" Text="ETA" Margin="0,0,0,3"/>
                <TextBlock x:Name="EtaText" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource TextPrimary}" Text="—" TextTrimming="None"/>
              </StackPanel>
            </UniformGrid>
          </Grid>

          <Button x:Name="LaunchButton" Style="{StaticResource LaunchBtn}" Height="56" Padding="22,0"
                  Margin="0,26,0,0"
                  Click="LaunchButton_Click">
            <StackPanel Orientation="Horizontal">
              <Polygon Points="0,0 0,12 10,6" Fill="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="LAUNCH" FontSize="14" FontWeight="SemiBold"
                         FontFamily="{StaticResource SansFont}"
                         Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="#04FFFFFF"
              BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
              Padding="18,10">
        <Grid>
          <TextBlock x:Name="VersionText" Text="v—"
                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                     FontWeight="Medium"
                     Foreground="{StaticResource TextFaint}"
                     HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource FooterLink}" Text="WEBSITE" MouseLeftButtonUp="Website_Click"/>
            <TextBlock Style="{StaticResource FooterLink}" Text=" · " Cursor="Arrow"/>
            <TextBlock Style="{StaticResource FooterLink}" Text="DISCORD" MouseLeftButtonUp="Discord_Click"/>
            <TextBlock Style="{StaticResource FooterLink}" Text=" · " Cursor="Arrow"/>
            <TextBlock Style="{StaticResource FooterLink}" Text="FORUM" MouseLeftButtonUp="Forum_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" d:Visibility="Collapsed">
      <Canvas Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
              CacheMode="BitmapCache">
        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="40" Height="40"
                 Stroke="#14FFFFFF" StrokeThickness="2.5"/>
        <Path Stroke="#E81E13" StrokeThickness="2.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M 24,4 A 20,20 0 0 1 41.32,34">
          <Path.RenderTransform>
            <RotateTransform x:Name="SpinnerRotate" CenterX="24" CenterY="24" Angle="0"/>
          </Path.RenderTransform>
          <Path.Triggers>
            <EventTrigger RoutedEvent="Path.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                   Storyboard.TargetProperty="Angle"
                                   From="0" To="360" Duration="0:0:0.9"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Path.Triggers>
        </Path>
      </Canvas>
      <Grid.Triggers>
        <EventTrigger RoutedEvent="Grid.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Content"
                               Storyboard.TargetProperty="Opacity"
                               BeginTime="0:0:2.5"
                               From="0" To="1" Duration="0:0:0.4"/>
              <DoubleAnimation Storyboard.TargetName="LoadingOverlay"
                               Storyboard.TargetProperty="Opacity"
                               BeginTime="0:0:2.5"
                               From="1" To="0" Duration="0:0:0.4"/>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoadingOverlay"
                                             Storyboard.TargetProperty="Visibility"
                                             BeginTime="0:0:2.95">
                <DiscreteObjectKeyFrame KeyTime="0:0:0">
                  <DiscreteObjectKeyFrame.Value>
                    <Visibility>Collapsed</Visibility>
                  </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
              </ObjectAnimationUsingKeyFrames>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Grid.Triggers>
    </Grid>
  </Grid>
</Window>
